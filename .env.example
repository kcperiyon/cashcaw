# Copy to .env.local and fill in. Never commit .env.local.
# DATABASE_URL lives in .env (Prisma 7's config loader reads .env, not
# .env.local — see prisma7.config.ts). Copy this block there too for local dev.

DATABASE_URL="postgresql://cashcaw_dev:cashcaw_dev_local_only@localhost:5432/cashcaw_dev"

ANTHROPIC_API_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ../platform-services' knowledge/RAG service, reached through an
# authenticated nginx path on wa.lagosbusinessgroup.com (borrowed domain).
# This is the SAME shared secret Zeroid already uses (see
# zeroid/.env.local's PLATFORM_KNOWLEDGE_API_KEY) — Cashcaw is a third
# consumer of already-shared infrastructure, not a new integration.
PLATFORM_KNOWLEDGE_BASE_URL=
PLATFORM_KNOWLEDGE_API_KEY=

# Cashcaw's own dedicated Flutterwave sub-account — per the standing
# decision in the build plan, do NOT reuse the Mongozutu/Flux9/Zeroid
# shared account. Not needed until Phase 1's checkout work starts.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
