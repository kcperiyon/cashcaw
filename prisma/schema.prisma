// Phase 0+1 schema (see docs/business-methodology.md and the published build
// plan's "Data model & API surface" section). Every tenant-scoped model
// below carries an organizationId column and gets a matching Postgres RLS
// policy in migrations/<ts>_rls/migration.sql — app-level scoping via
// src/lib/tenant-db.ts is the primary defense, RLS is the backstop. Same
// two-layer pattern as Zeroid and Closa, reused verbatim rather than
// re-derived.
//
// Phase 1 adds: InterviewMessage/ExpertiseFact (the Expertise Interview) and
// Opportunity (the Opportunity Finder). Deliberately NOT modeled yet
// (Phase 1's Product Factory/Offer/Checkout, or later): Product, Offer,
// SalesPage, Order, AiCreditWallet, VideoCreditWallet, AffiliateLink,
// LedgerEntry.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL for migrate/introspect comes from prisma7.config.ts (Prisma 7
// moved it out of the schema file). PrismaClient at runtime still needs its
// own url/adapter wiring wherever it's constructed — see src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

enum OrgRole {
  owner
  editor
  viewer
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships       OrgMembership[]
  knowledgeSources  KnowledgeSource[]
  interviewMessages InterviewMessage[]
  expertiseFacts    ExpertiseFact[]
  opportunities     Opportunity[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  memberships OrgMembership[]
}

// A user's role within one organization. A user can belong to more than one
// organization — role is per-membership, never global.
model OrgMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(owner)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum KnowledgeSourceKind {
  text
  url
}

// Tracks WHICH sources this org has fed into "My Expertise" — the actual
// content lives in platform-services' knowledge/RAG service, never here
// (see src/lib/knowledge/client.ts and the build plan's reuse map). This row
// exists so the UI can list what's been ingested and delete it from both
// places.
model KnowledgeSource {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  kind           KnowledgeSourceKind
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

enum InterviewRole {
  founder
  interviewer
}

// The Expertise Interview transcript (docs/business-methodology.md's input
// side). Kept separate from KnowledgeSource — this is structured
// question/answer, not a free-text document — and separate from
// ExpertiseFact below: a message is what was SAID, a fact is what was
// EXTRACTED from it. Both persist so the interview can resume and so facts
// are auditable back to the message that produced them.
model InterviewMessage {
  id             String        @id @default(cuid())
  organizationId String
  role           InterviewRole
  content        String
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

// Concrete, extracted facts about the founder's expertise — the actual
// input to proposeOpportunities() (src/lib/ai/provider.ts). Deliberately
// flat strings, not embeddings: at this volume (a handful to a few dozen
// facts per org) there's no retrieval problem to solve, unlike the
// paragraph-length notes in KnowledgeSource/platform-services.
model ExpertiseFact {
  id             String   @id @default(cuid())
  organizationId String
  content        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

enum OpportunityStatus {
  proposed
  selected
  archived
}

// One row per opportunity candidate. Sub-scores + evidence come from the AI
// provider (ProposedOpportunity); overallScore is ALWAYS computed by
// src/lib/methodology/scoring.ts from the weights in
// docs/business-methodology.md §2 — never trusted from the model — and
// stored, not recomputed on every read, so a past run stays explainable
// even if the weights change later (same never-rewrite-history discipline
// as Mongozutu's Rules Engine).
model Opportunity {
  id             String            @id @default(cuid())
  organizationId String
  title          String
  audience       String
  problem        String

  demandScore         Int
  demandEvidence      String
  expertiseFitScore   Int
  competitionDensity  Int
  competitionEvidence String
  monetisationScore   Int
  overallScore        Int

  status    OpportunityStatus @default(proposed)
  createdAt DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, overallScore])
}
